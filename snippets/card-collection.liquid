{% doc %}
  Maison collection card.

  @param {collection} [card_collection] - Collection to render
  @param {number} [columns] - Column count for image sizes
  @param {string} [placeholder_image] - Placeholder SVG name when empty
  @example
  {% render 'card-collection', card_collection: collection, columns: 3 %}
{% enddoc %}

{%- liquid
  assign columns_count = columns | default: 3
  assign collection_image = card_collection.featured_image
  if collection_image == blank and card_collection.products.first != blank
    assign collection_image = card_collection.products.first.featured_image
  endif
  assign product_count = card_collection.all_products_count | default: 0
-%}

{%- if card_collection and card_collection != empty -%}
  <article class="maison-flacon-card maison-collection-card">
    <div class="maison-flacon-card__visual maison-collection-card__visual">
      <span class="maison-flacon-card__badge">
        {{ 'products.facets.product_count_simple' | t: count: product_count }}
      </span>
      {%- if collection_image -%}
        <div class="maison-collection-card__media">
          {{
            collection_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '330, 535, 750, 1000, 1200',
              sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
              alt: card_collection.title
          }}
        </div>
      {%- else -%}
        <div class="maison-flacon-card__mini">
          <div class="maison-flacon-card__mini-cap"></div>
          <div class="maison-flacon-card__mini-label">
            <strong>{{ card_collection.title | truncatewords: 1, '' | upcase | escape }}</strong>
            <small>MAISON</small>
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="maison-flacon-card__details">
      <div class="maison-flacon-card__price-row">
        <h3 class="maison-flacon-card__title">
          <a href="{{ card_collection.url }}">{{ card_collection.title | escape }}</a>
        </h3>
      </div>
      {%- if card_collection.description != blank -%}
        <p class="maison-flacon-card__desc">
          {{ card_collection.description | strip_html | truncate: 140 }}
        </p>
      {%- endif -%}
      <div class="maison-flacon-card__actions">
        <a class="mv-cta maison-flacon-card__btn" href="{{ card_collection.url }}">
          <span>{{ 'sections.collection_list.view_all' | t }}</span>
        </a>
      </div>
    </div>
  </article>
{%- else -%}
  <article class="maison-flacon-card maison-collection-card">
    <div class="maison-flacon-card__visual maison-collection-card__visual">
      <span class="maison-flacon-card__badge">Collection</span>
      <div class="maison-flacon-card__mini">
        <div class="maison-flacon-card__mini-cap"></div>
        <div class="maison-flacon-card__mini-label">
          <strong>VEIL</strong>
          <small>MAISON</small>
        </div>
      </div>
    </div>
    <div class="maison-flacon-card__details">
      <div class="maison-flacon-card__price-row">
        <h3 class="maison-flacon-card__title">{{ 'onboarding.collection_title' | t }}</h3>
      </div>
      <div class="maison-flacon-card__actions">
        <span class="mv-cta maison-flacon-card__btn">
          <span>{{ 'sections.collection_list.view_all' | t }}</span>
        </span>
      </div>
    </div>
  </article>
{%- endif -%}
