{% doc %}
  Alias for the Maison product card. Prefer `card-product` in new code.

  @param {product} product - Product to render
  @param {string} [badge] - Optional badge text
  @param {string} [family] - Optional scent-family line
  @param {string} [filter_tag] - Filter category for compositions
  @param {string} [monogram] - Fallback flacon label
  @param {boolean} [skip_styles] - Skip stylesheet and script tags
  @param {string} [section_id] - Section id for unique form ids
  @example
  {% render 'maison-flacon-card', product: product, filter_tag: 'nocturnal' %}
{% enddoc %}

{% render 'card-product',
  card_product: product,
  badge: badge,
  family: family,
  filter_tag: filter_tag,
  monogram: monogram,
  skip_styles: skip_styles,
  section_id: section_id
%}
