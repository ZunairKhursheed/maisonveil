{% doc %}
  Maison article card.

  @param {article} article - Article to render
  @param {blog} [blog] - Parent blog
  @param {boolean} [show_image] - Show featured image. Default true
  @param {boolean} [show_date] - Show published date
  @param {boolean} [show_author] - Show author
  @param {boolean} [show_excerpt] - Show excerpt
  @param {boolean} [show_badge] - Show blog badge
  @param {boolean} [lazy_load] - Lazy-load media. Default true
  @example
  {% render 'article-card', article: article, show_image: true, show_date: true %}
{% enddoc %}

{%- liquid
  assign show_media = true
  if show_image == false
    assign show_media = false
  endif
  assign lazy_media = true
  if lazy_load == false
    assign lazy_media = false
  endif
-%}

{%- if article and article != empty -%}
  <article class="maison-flacon-card maison-article-card">
    <div class="maison-flacon-card__visual maison-collection-card__visual">
      {%- if show_badge -%}
        <span class="maison-flacon-card__badge">{{ 'blogs.article.blog' | t }}</span>
      {%- endif -%}
      {%- if show_media and article.image -%}
        <div class="maison-collection-card__media">
          {%- if lazy_media -%}
            {{
              article.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '360, 533, 720, 1000, 1200',
                sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                alt: article.title
            }}
          {%- else -%}
            {{
              article.image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                widths: '360, 533, 720, 1000, 1200',
                sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                alt: article.title
            }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="maison-flacon-card__mini">
          <div class="maison-flacon-card__mini-cap"></div>
          <div class="maison-flacon-card__mini-label">
            <strong>{{ article.title | truncatewords: 1, '' | upcase | escape }}</strong>
            <small>JOURNAL</small>
          </div>
        </div>
      {%- endif -%}
    </div>
    <div class="maison-flacon-card__details">
      <div class="maison-flacon-card__price-row">
        <h3 class="maison-flacon-card__title">
          <a href="{{ article.url }}">{{ article.title | escape }}</a>
        </h3>
      </div>
      {%- if show_date or show_author -%}
        <div class="maison-flacon-card__family">
          {%- if show_date -%}
            {{ article.published_at | time_tag: format: 'date' }}
          {%- endif -%}
          {%- if show_date and show_author -%}
            ·
          {%- endif -%}
          {%- if show_author -%}
            {{ article.author }}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if show_excerpt -%}
        {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
          <p class="maison-flacon-card__desc">
            {%- if article.excerpt.size > 0 -%}
              {{ article.excerpt | strip_html | truncate: 140 }}
            {%- else -%}
              {{ article.content | strip_html | truncate: 140 }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {%- endif -%}
      <div class="maison-flacon-card__actions">
        <a class="mv-cta maison-flacon-card__btn" href="{{ article.url }}" aria-label="{{ 'blogs.article.read_more_title' | t: title: article.title }}">
          <span>{{ 'blogs.article.read_more' | t }}</span>
        </a>
      </div>
    </div>
  </article>
{%- else -%}
  <article class="maison-flacon-card maison-article-card">
    <div class="maison-flacon-card__visual maison-collection-card__visual">
      <span class="maison-flacon-card__badge">{{ 'blogs.article.blog' | t }}</span>
      <div class="maison-flacon-card__mini">
        <div class="maison-flacon-card__mini-cap"></div>
        <div class="maison-flacon-card__mini-label">
          <strong>VEIL</strong>
          <small>JOURNAL</small>
        </div>
      </div>
    </div>
    <div class="maison-flacon-card__details">
      <div class="maison-flacon-card__price-row">
        <h3 class="maison-flacon-card__title">{{ 'sections.featured_blog.onboarding_title' | t }}</h3>
      </div>
      <p class="maison-flacon-card__desc">{{ 'sections.featured_blog.onboarding_content' | t }}</p>
    </div>
  </article>
{%- endif -%}
