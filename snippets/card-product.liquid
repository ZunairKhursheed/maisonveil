{% doc %}
  Maison product card used across collection, search, featured, related, and landing sections.

  @param {product} [card_product] - Product to render (Dawn convention)
  @param {product} [product] - Product to render (alias for card_product)
  @param {string} [badge] - Optional badge text
  @param {string} [family] - Optional scent-family / vendor line
  @param {string} [filter_tag] - Filter category for compositions
  @param {string} [monogram] - Fallback flacon label when no image
  @param {boolean} [lazy_load] - Lazy-load the media. Default true
  @param {boolean} [skip_styles] - Skip stylesheet and script tags
  @param {string} [section_id] - Section id for unique form ids
  @param {boolean} [show_vendor] - Show vendor when family is not passed
  @example
  {% render 'card-product', card_product: product, section_id: section.id %}
{% enddoc %}

{%- liquid
  assign card_product = card_product | default: product
  assign lazy_media = true
  if lazy_load == false
    assign lazy_media = false
  endif
-%}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign variant = card_product.selected_or_first_available_variant
    assign badge_label = badge
    if badge_label == blank and card_product.metafields.custom.badge != blank
      assign badge_label = card_product.metafields.custom.badge.value
    endif
    if badge_label == blank and card_product.available == false
      assign badge_label = 'products.product.sold_out' | t
    elsif badge_label == blank and card_product.compare_at_price > card_product.price
      assign badge_label = 'products.product.on_sale' | t
    elsif badge_label == blank
      assign badge_label = card_product.type | default: 'Extrait'
    endif

    assign family_label = family
    if family_label == blank and card_product.metafields.custom.scent_family != blank
      assign family_label = card_product.metafields.custom.scent_family.value
    endif
    if family_label == blank
      if show_vendor == false
        assign family_label = blank
      else
        assign family_label = card_product.vendor
      endif
    endif

    assign monogram_text = monogram
    if monogram_text == blank and card_product.metafields.custom.monogram != blank
      assign monogram_text = card_product.metafields.custom.monogram.value
    endif
    if monogram_text == blank
      assign monogram_text = card_product.title | truncatewords: 1, '' | upcase
    endif
    if monogram_text == blank
      assign monogram_text = 'VEIL'
    endif

    assign category = filter_tag | default: 'all'
    assign form_id = 'ProductCardForm-' | append: section_id | append: '-' | append: card_product.id
  -%}

  <article
    class="maison-flacon-card"
    data-maison-category="{{ category | escape }}"
    data-product-id="{{ card_product.id }}"
  >
    <div class="maison-flacon-card__visual">
      {%- if badge_label != blank -%}
        <span class="maison-flacon-card__badge">{{ badge_label | escape }}</span>
      {%- endif -%}

      {%- if card_product.featured_media -%}
        {%- assign img_alt = card_product.featured_media.alt | default: card_product.title | escape -%}
        <div class="maison-flacon-card__image">
          {%- if lazy_media -%}
            {{
              card_product.featured_media
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '300, 400, 600, 800',
                sizes: '(min-width: 990px) 28vw, (min-width: 750px) 45vw, 90vw',
                alt: img_alt
            }}
          {%- else -%}
            {{
              card_product.featured_media
              | image_url: width: 800
              | image_tag:
                loading: 'eager',
                widths: '300, 400, 600, 800',
                sizes: '(min-width: 990px) 28vw, (min-width: 750px) 45vw, 90vw',
                alt: img_alt
            }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="maison-flacon-card__mini">
          <div class="maison-flacon-card__mini-cap"></div>
          <div class="maison-flacon-card__mini-label">
            <strong>{{ monogram_text | escape }}</strong>
            <small>EXTRAIT</small>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="maison-flacon-card__details">
      <h3 class="maison-flacon-card__title">
        <a
          href="{{ card_product.url }}"
          id="CardLink-{{ section_id }}-{{ card_product.id }}"
          class="maison-flacon-card__link"
          aria-label="{{ 'products.product.view_product_details' | t: product_name: card_product.title }}"
        >
          {{ card_product.title | escape }}
        </a>
      </h3>
      <div class="maison-flacon-card__price">
        {%- if variant.compare_at_price > variant.price -%}
          <s>{{ variant.compare_at_price | money }}</s>
        {%- endif -%}
        {{ variant.price | money }}
      </div>

      {%- if family_label != blank -%}
        <div class="maison-flacon-card__family">{{ family_label | escape }}</div>
      {%- endif -%}

      {%- if variant -%}
        <div class="maison-flacon-card__actions">
          <product-form class="maison-flacon-card__form" data-hide-errors="true">
            {%- form 'product', card_product, id: form_id, class: 'maison-flacon-card__form', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ variant.id }}" class="product-variant-id">
              <button
                type="submit"
                name="add"
                class="mv-cta maison-flacon-card__btn"
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                <span>
                  {%- if variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </span>
                {%- render 'loading-spinner' -%}
              </button>
            {%- endform -%}
          </product-form>
        </div>
      {%- endif -%}
    </div>
  </article>
{%- else -%}
  <article class="maison-flacon-card" data-maison-category="all">
    <div class="maison-flacon-card__visual">
      <span class="maison-flacon-card__badge">Extrait</span>
      <div class="maison-flacon-card__mini">
        <div class="maison-flacon-card__mini-cap"></div>
        <div class="maison-flacon-card__mini-label">
          <strong>VEIL</strong>
          <small>EXTRAIT</small>
        </div>
      </div>
    </div>
    <div class="maison-flacon-card__details">
      <h3 class="maison-flacon-card__title">{{ 'onboarding.product_title' | t }}</h3>
      <div class="maison-flacon-card__price">$245</div>
      <div class="maison-flacon-card__family">Maison Veil</div>
      <div class="maison-flacon-card__actions">
        <span class="mv-cta maison-flacon-card__btn"><span>{{ 'products.product.add_to_cart' | t }}</span></span>
      </div>
    </div>
  </article>
{%- endif -%}
