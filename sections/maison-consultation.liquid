{{ 'section-maison-consultation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-consultation.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign result_blocks = section.blocks | where: 'type', 'result'
-%}

<maison-consultation
  class="maison-consultation"
  id="consultation"
  data-section-id="{{ section.id }}"
>
  <div class="maison-consultation__wrap">
    <div class="maison-consultation__head mv-reveal">
      {%- if section.settings.kicker != blank -%}
        <div class="maison-consultation__kicker">{{ section.settings.kicker | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="maison-consultation__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="maison-consultation__divider" aria-hidden="true"></div>
      {%- if section.settings.description != blank -%}
        <div class="maison-consultation__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="maison-consultation__box mv-reveal">
      <div class="maison-consultation__progress" aria-hidden="true">
        {%- for step in step_blocks -%}
          <div
            class="maison-consultation__progress-step{% if forloop.first %} is-done{% endif %}"
            data-quiz-progress="{{ forloop.index }}"
          ></div>
        {%- endfor -%}
      </div>

      {%- for block in step_blocks -%}
        {%- assign step_index = forloop.index -%}
        <div
          class="maison-consultation__step{% unless forloop.first %} is-hidden{% endunless %}"
          data-quiz-step="{{ step_index }}"
          {{ block.shopify_attributes }}
        >
          <h3 class="maison-consultation__step-title">{{ block.settings.question | escape }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="maison-consultation__step-desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
          <div class="maison-consultation__options">
            {%- for i in (1..3) -%}
              {%- liquid
                case i
                  when 1
                    assign opt_key = block.settings.option_1_key
                    assign opt_icon = block.settings.option_1_icon
                    assign opt_title = block.settings.option_1_title
                    assign opt_sub = block.settings.option_1_sub
                  when 2
                    assign opt_key = block.settings.option_2_key
                    assign opt_icon = block.settings.option_2_icon
                    assign opt_title = block.settings.option_2_title
                    assign opt_sub = block.settings.option_2_sub
                  when 3
                    assign opt_key = block.settings.option_3_key
                    assign opt_icon = block.settings.option_3_icon
                    assign opt_title = block.settings.option_3_title
                    assign opt_sub = block.settings.option_3_sub
                endcase
              -%}
              {%- if opt_title != blank -%}
                <button
                  type="button"
                  class="maison-consultation__option"
                  data-quiz-choice="{{ opt_key | default: 'noir' | handleize | escape }}"
                  data-quiz-step-index="{{ step_index }}"
                >
                  {%- if opt_icon != blank -%}
                    <span class="maison-consultation__option-icon">{{ opt_icon | escape }}</span>
                  {%- endif -%}
                  <span class="maison-consultation__option-title">{{ opt_title | escape }}</span>
                  {%- if opt_sub != blank -%}
                    <span class="maison-consultation__option-sub">{{ opt_sub | escape }}</span>
                  {%- endif -%}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}

      <div class="maison-consultation__result" data-quiz-result hidden>
        <span class="maison-consultation__pill" data-quiz-score></span>
        <h3 class="maison-consultation__result-title" data-quiz-title></h3>
        <p class="maison-consultation__result-desc" data-quiz-desc></p>
        <div class="maison-consultation__result-actions">
          <a class="button maison-consultation__btn maison-consultation__btn--primary" data-quiz-claim href="#">
            {{ section.settings.claim_label | default: 'Claim Flacon' | escape }}
          </a>
          <button type="button" class="maison-consultation__btn maison-consultation__btn--outline" data-quiz-reset>
            {{ section.settings.retake_label | default: 'Retake Consultation' | escape }}
          </button>
        </div>
      </div>

      <script type="application/json" data-quiz-results>
        {
          {%- for block in result_blocks -%}
            "{{ block.settings.key | handleize | escape }}": {
              "title": {{ block.settings.title | json }},
              "score": {{ block.settings.score | json }},
              "desc": {{ block.settings.description | json }},
              "url": {% if block.settings.product != blank %}{{ block.settings.product.url | json }}{% else %}{{ block.settings.link | json }}{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      </script>
    </div>
  </div>
</maison-consultation>

