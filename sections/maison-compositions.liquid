{{ 'section-maison-compositions.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-compositions.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products_to_show = section.settings.products_to_show | default: 6
  assign columns = section.settings.columns_desktop | default: 3
  assign has_collection_filters = false

  for block in section.blocks
    if block.type == 'filter' and block.settings.collection != blank
      assign has_collection_filters = true
      break
    endif
  endfor
-%}

<maison-compositions
  class="maison-compositions color-{{ section.settings.color_scheme }} isolate gradient"
  id="collection"
  data-section-id="{{ section.id }}"
>
  <div class="maison-compositions__wrap">
    <div class="maison-compositions__head mv-reveal">
      <div class="maison-compositions__head-copy">
        {%- if section.settings.kicker != blank -%}
          <div class="maison-compositions__kicker">{{ section.settings.kicker | escape }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="maison-compositions__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.description != blank -%}
        <div class="maison-compositions__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if has_collection_filters -%}
      <div class="maison-compositions__filters mv-reveal" role="tablist" aria-label="{{ section.settings.title | escape }}">
        <button
          type="button"
          class="maison-compositions__filter is-active"
          data-maison-filter="all"
        >
          {{ section.settings.filter_all_label | default: 'All Compositions' | escape }}
        </button>
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter' and block.settings.collection != blank -%}
            {%- liquid
              assign filter_handle = block.settings.collection.handle
              assign filter_label = block.settings.label | strip
              if filter_label == blank
                assign filter_label = block.settings.collection.title
              endif
            -%}
            <button
              type="button"
              class="maison-compositions__filter"
              data-maison-filter="{{ filter_handle | escape }}"
              {{ block.shopify_attributes }}
            >
              {{ filter_label | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div
      class="maison-compositions__grid"
      style="--maison-compositions-cols: {{ columns }};"
    >
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: products_to_show -%}
          {%- liquid
            assign product_filters = ''

            for block in section.blocks
              if block.type == 'filter' and block.settings.collection != blank
                assign filter_handle = block.settings.collection.handle
                assign matched = false

                for product_collection in product.collections
                  if product_collection.handle == filter_handle
                    assign matched = true
                    break
                  endif
                endfor

                if matched
                  assign product_filters = product_filters | append: filter_handle | append: ' '
                endif
              endif
            endfor

            assign product_filters = product_filters | strip
            if product_filters == blank
              assign product_filters = 'all'
            endif

            assign badge = product.type
            if product.metafields.custom.badge != blank
              assign badge = product.metafields.custom.badge.value
            endif
            assign family = product.vendor
            if product.metafields.custom.scent_family != blank
              assign family = product.metafields.custom.scent_family.value
            endif
            assign mono = blank
            if product.metafields.custom.monogram != blank
              assign mono = product.metafields.custom.monogram.value
            endif
          -%}
          {% render 'maison-flacon-card',
            product: product,
            badge: badge,
            family: family,
            filter_tag: product_filters,
            monogram: mono,
            skip_styles: true,
            section_id: section.id
          %}
        {%- else -%}
          <p class="maison-compositions__empty">{{ 'sections.collection_template.empty' | t }}</p>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {% render 'card-product', skip_styles: true %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</maison-compositions>

{% schema %}
{
  "name": "Maison compositions",
  "tag": "section",
  "class": "section-maison-compositions",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.maison_compositions.settings.kicker.label",
      "default": "01 · The Master Works"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.maison_compositions.settings.title.label",
      "default": "The Signature <em>Compositions.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.maison_compositions.settings.description.label",
      "default": "<p>Original luxury fragrances and body oils inspired by iconic accords—florals, ambers, woods, and gourmands composed for everyday presence.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.maison_compositions.settings.collection.label",
      "info": "t:sections.maison_compositions.settings.collection.info"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "t:sections.maison_compositions.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.maison_compositions.settings.columns_desktop.label"
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "t:sections.maison_compositions.settings.filter_all_label.label",
      "default": "All Compositions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "t:sections.maison_compositions.blocks.filter.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.maison_compositions.blocks.filter.settings.label.label",
          "default": "Perfume",
          "info": "t:sections.maison_compositions.blocks.filter.settings.label.info"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.maison_compositions.blocks.filter.settings.collection.label",
          "info": "t:sections.maison_compositions.blocks.filter.settings.collection.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maison compositions",
      "blocks": [
        { "type": "filter", "settings": { "label": "Perfumes" } },
        { "type": "filter", "settings": { "label": "Body Oils" } },
        { "type": "filter", "settings": { "label": "Shimmer Oils" } },
        { "type": "filter", "settings": { "label": "Discovery Sets" } }
      ]
    }
  ]
}
{% endschema %}
