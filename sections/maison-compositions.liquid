{{ 'section-maison-compositions.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-compositions.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign products_to_show = section.settings.products_to_show | default: 6
  assign columns = section.settings.columns_desktop | default: 3
-%}

<maison-compositions
  class="maison-compositions color-{{ section.settings.color_scheme }} isolate gradient"
  id="collection"
  data-section-id="{{ section.id }}"
>
  <div class="maison-compositions__wrap">
    <div class="maison-compositions__head mv-reveal">
      <div class="maison-compositions__head-copy">
        {%- if section.settings.kicker != blank -%}
          <div class="maison-compositions__kicker">{{ section.settings.kicker | escape }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="maison-compositions__title">{{ section.settings.title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.description != blank -%}
        <div class="maison-compositions__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="maison-compositions__filters mv-reveal" role="tablist" aria-label="{{ section.settings.title | escape }}">
        <button
          type="button"
          class="maison-compositions__filter is-active"
          data-maison-filter="all"
        >
          {{ section.settings.filter_all_label | default: 'All Compositions' | escape }}
        </button>
        {%- for block in section.blocks -%}
          {%- if block.type == 'filter' and block.settings.label != blank -%}
            <button
              type="button"
              class="maison-compositions__filter"
              data-maison-filter="{{ block.settings.tag | handleize | escape }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div
      class="maison-compositions__grid"
      style="--maison-compositions-cols: {{ columns }};"
    >
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: products_to_show -%}
          {%- liquid
            assign product_filters = ''
            assign product_type_l = product.type | downcase | strip
            assign product_title_l = product.title | downcase
            assign product_handle_l = product.handle | downcase

            assign is_gift = false
            if product_title_l contains 'gift card'
              assign is_gift = true
            endif

            assign is_home = false
            if product_title_l contains 'plug in' or product_title_l contains 'scent tower' or product_handle_l contains 'scent-plug' or product_handle_l contains 'scent-tower'
              assign is_home = true
            endif

            assign is_discovery = false
            if product_title_l contains 'discovery' or product_title_l contains 'collection'
              assign is_discovery = true
            endif

            assign is_shimmer = false
            if product_type_l contains 'shimmer' or product_title_l contains 'shimmer'
              assign is_shimmer = true
            endif

            assign is_body_oil = false
            if is_shimmer == false
              if product_type_l == 'body oil' or product_type_l contains 'body oil'
                assign is_body_oil = true
              endif
            endif

            assign is_perfume = false
            if is_gift == false and is_home == false and is_shimmer == false and is_body_oil == false
              if product_type_l == 'perfume' or product_type_l contains 'parfum'
                assign is_perfume = true
              elsif product_type_l == blank and is_discovery == false
                assign is_perfume = true
              endif
            endif

            for block in section.blocks
              if block.type == 'filter' and block.settings.tag != blank
                assign tag_handle = block.settings.tag | handleize
                assign matched = false

                for product_tag in product.tags
                  assign product_tag_l = product_tag | downcase | strip | handleize
                  if product_tag_l == tag_handle
                    assign matched = true
                  endif
                endfor

                if tag_handle == 'perfume' and is_perfume
                  assign matched = true
                elsif tag_handle == 'body-oil' and is_body_oil
                  assign matched = true
                elsif tag_handle == 'shimmer' and is_shimmer
                  assign matched = true
                elsif tag_handle == 'discovery' or tag_handle == 'discovery-collection'
                  if is_discovery
                    assign matched = true
                  endif
                elsif tag_handle == 'home' or tag_handle == 'home-scenting'
                  if is_home
                    assign matched = true
                  endif
                endif

                if matched
                  assign product_filters = product_filters | append: tag_handle | append: ' '
                endif
              endif
            endfor
            assign product_filters = product_filters | strip
            if product_filters == blank
              assign product_filters = 'all'
            endif

            assign badge = product.type
            if product.metafields.custom.badge != blank
              assign badge = product.metafields.custom.badge.value
            endif
            assign family = product.vendor
            if product.metafields.custom.scent_family != blank
              assign family = product.metafields.custom.scent_family.value
            endif
            assign mono = blank
            if product.metafields.custom.monogram != blank
              assign mono = product.metafields.custom.monogram.value
            endif
          -%}
          {% render 'maison-flacon-card',
            product: product,
            badge: badge,
            family: family,
            filter_tag: product_filters,
            monogram: mono,
            skip_styles: true,
            section_id: section.id
          %}
        {%- else -%}
          <p class="maison-compositions__empty">{{ 'sections.collection_template.empty' | t }}</p>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          {% render 'card-product', skip_styles: true %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</maison-compositions>

{% schema %}
{
  "name": "Maison compositions",
  "tag": "section",
  "class": "section-maison-compositions",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.maison_compositions.settings.kicker.label",
      "default": "01 · The Master Works"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:sections.maison_compositions.settings.title.label",
      "default": "The Signature <em>Compositions.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.maison_compositions.settings.description.label",
      "default": "<p>Original luxury fragrances and body oils inspired by iconic accords—florals, ambers, woods, and gourmands composed for everyday presence.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.maison_compositions.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "t:sections.maison_compositions.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.maison_compositions.settings.columns_desktop.label"
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "t:sections.maison_compositions.settings.filter_all_label.label",
      "default": "All Compositions"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "t:sections.maison_compositions.blocks.filter.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.maison_compositions.blocks.filter.settings.label.label",
          "default": "Perfume"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "t:sections.maison_compositions.blocks.filter.settings.tag.label",
          "info": "t:sections.maison_compositions.blocks.filter.settings.tag.info",
          "default": "perfume"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maison compositions",
      "blocks": [
        { "type": "filter", "settings": { "label": "Perfumes", "tag": "perfume" } },
        { "type": "filter", "settings": { "label": "Body Oils", "tag": "body-oil" } },
        { "type": "filter", "settings": { "label": "Shimmer Oils", "tag": "shimmer" } },
        { "type": "filter", "settings": { "label": "Discovery Sets", "tag": "discovery" } }
      ]
    }
  ]
}
{% endschema %}
