{{ 'section-maison-engraving.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-engraving.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_product = section.settings.product
  assign variant = featured_product.selected_or_first_available_variant
  assign max_chars = section.settings.max_characters | default: 12
  assign default_text = section.settings.default_engraving | default: 'M · VEIL'
-%}

<maison-engraving
  class="maison-engraving color-{{ section.settings.color_scheme }} isolate gradient"
  id="engraving"
  data-section-id="{{ section.id }}"
>
  <div class="maison-engraving__wrap">
    <div class="maison-engraving__grid">
      <div class="maison-engraving__panel mv-reveal">
        {%- if section.settings.kicker != blank -%}
          <div class="maison-engraving__kicker">{{ section.settings.kicker | escape }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="maison-engraving__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="maison-engraving__desc">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if featured_product != blank -%}
          <div class="maison-engraving__product">
            <span class="maison-engraving__product-name">{{ featured_product.title | escape }}</span>
            <span class="maison-engraving__product-price">{{ variant.price | money }}</span>
          </div>
        {%- endif -%}

        <div class="maison-engraving__input-wrap">
          <label class="maison-engraving__label" for="EngravingInput-{{ section.id }}">
            {{ section.settings.input_label | escape }}
          </label>
          <input
            type="text"
            id="EngravingInput-{{ section.id }}"
            class="maison-engraving__input"
            maxlength="{{ max_chars }}"
            value="{{ default_text | escape }}"
            data-engraving-input
            aria-describedby="EngravingCount-{{ section.id }}"
          >
          <div class="maison-engraving__count" id="EngravingCount-{{ section.id }}">
            <span data-engraving-count>{{ default_text.size }}</span> / {{ max_chars }} Characters
          </div>
        </div>

        <div class="maison-engraving__fonts" role="group" aria-label="{{ section.settings.font_group_label | escape }}">
          <button type="button" class="maison-engraving__font-btn is-active" data-engraving-font="monumental">
            {{ section.settings.font_1_label | escape }}
          </button>
          <button type="button" class="maison-engraving__font-btn" data-engraving-font="editorial">
            {{ section.settings.font_2_label | escape }}
          </button>
        </div>

        {%- if featured_product != blank and variant -%}
          {%- form 'product', featured_product, class: 'maison-engraving__form', id: 'EngravingForm-{{ section.id }}' -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
            <input type="hidden" name="properties[Engraving]" value="{{ default_text | escape }}" data-engraving-property>
            <button
              type="submit"
              name="add"
              class="maison-engraving__submit"
              {% unless variant.available %}disabled{% endunless %}
            >
              {%- if variant.available -%}
                {{ section.settings.button_label | escape }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          {%- endform -%}
          <script>
            (() => {
              const root = document.querySelector('[data-section-id="{{ section.id }}"]');
              if (!root) return;
              const input = root.querySelector('[data-engraving-input]');
              const property = root.querySelector('[data-engraving-property]');
              if (!input || !property) return;
              input.addEventListener('input', () => {
                property.value = input.value.toUpperCase();
              });
            })();
          </script>
        {%- else -%}
          <button type="button" class="maison-engraving__submit" disabled>
            {{ section.settings.button_label | escape }}
          </button>
        {%- endif -%}
      </div>

      <div class="maison-engraving__preview mv-reveal">
        {%- if section.settings.monogram != blank -%}
          {{
            section.settings.monogram
            | image_url: width: 120
            | image_tag: class: 'maison-engraving__shield', loading: 'lazy', alt: section.settings.monogram.alt | default: shop.name
          }}
        {%- endif -%}
        <div class="maison-engraving__bottle">
          <div class="maison-engraving__cap" aria-hidden="true"></div>
          <div class="maison-engraving__label-wrap">
            <h4 class="maison-engraving__label-title">{{ section.settings.bottle_label | default: 'VEIL' | escape }}</h4>
            <small class="maison-engraving__label-sub">{{ section.settings.bottle_subtitle | default: 'EXTRAIT DE PARFUM' | escape }}</small>
            <div class="maison-engraving__live-text" data-engraving-display>{{ default_text | escape }}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</maison-engraving>

{% schema %}
{
  "name": "Maison engraving",
  "tag": "section",
  "class": "section-maison-engraving",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "04 · Atelier Personalization"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Laser Gold <em>Engraving.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every flacon can be individually inscribed with your initials, a significant date, or a personal creed. Inscribed with ultra-precision 24K gold foil in our Paris atelier.</p>"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "image_picker",
      "id": "monogram",
      "label": "Monogram image"
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Input label",
      "default": "Inscribe Your Monogram / Date (Max 12 Chars)"
    },
    {
      "type": "text",
      "id": "default_engraving",
      "label": "Default engraving text",
      "default": "M · VEIL"
    },
    {
      "type": "range",
      "id": "max_characters",
      "min": 6,
      "max": 24,
      "step": 1,
      "default": 12,
      "label": "Maximum characters"
    },
    {
      "type": "text",
      "id": "font_group_label",
      "label": "Font selector label",
      "default": "Engraving style"
    },
    {
      "type": "text",
      "id": "font_1_label",
      "label": "Font 1 label",
      "default": "Roman Monumental"
    },
    {
      "type": "text",
      "id": "font_2_label",
      "label": "Font 2 label",
      "default": "Editorial Haute"
    },
    {
      "type": "text",
      "id": "bottle_label",
      "label": "Bottle label",
      "default": "VEIL"
    },
    {
      "type": "text",
      "id": "bottle_subtitle",
      "label": "Bottle subtitle",
      "default": "EXTRAIT DE PARFUM"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Save Engraving to Vessel"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "Maison engraving"
    }
  ]
}
{% endschema %}
