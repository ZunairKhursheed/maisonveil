{{ 'section-newsletter-popup.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
<script src="{{ 'newsletter-popup.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign image_layout = section.settings.image_layout
  if section.settings.image == blank
    assign image_layout = 'none'
  endif
  assign overlay_opacity = section.settings.image_overlay_opacity | divided_by: 100.0
  assign image_alt = section.settings.image.alt | default: section.settings.heading
-%}

<newsletter-popup
  id="NewsletterPopup-{{ section.id }}"
  class="newsletter-popup color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-hide-days="{{ section.settings.hide_days }}"
  data-storage-key="maisonveil-newsletter-popup-{{ section.id }}"
>
  <dialog
    class="newsletter-popup__dialog newsletter-popup__dialog--{{ image_layout }}"
    aria-labelledby="NewsletterPopupHeading-{{ section.id }}"
  >
    <div class="newsletter-popup__inner">
      {%- if image_layout == 'left' or image_layout == 'right' -%}
        <div class="newsletter-popup__media">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 750px) 40vw, 100vw',
              class: 'newsletter-popup__image',
              alt: image_alt
          }}
        </div>
      {%- endif -%}

      <div
        class="newsletter-popup__content{% if image_layout == 'background' %} newsletter-popup__content--has-background{% endif %}"
        {% if image_layout == 'background' %}
          style="
            --newsletter-popup-bg-image: url({{ section.settings.image | image_url: width: 1600 }});
            --newsletter-popup-overlay: {{ overlay_opacity }};
          "
        {% endif %}
      >
        <button
          type="button"
          class="newsletter-popup__close"
          aria-label="{{ 'accessibility.close' | t }}"
          data-newsletter-popup-close
        >
          {% render 'icon-close' %}
        </button>

        <div class="newsletter-popup__body">
          {%- if section.settings.heading != blank -%}
            <h2 class="newsletter-popup__heading {{ section.settings.heading_size }}" id="NewsletterPopupHeading-{{ section.id }}">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          {%- if section.settings.text != blank -%}
            <div class="newsletter-popup__text rte">
              {{ section.settings.text }}
            </div>
          {%- endif -%}

          {%- assign newsletter_popup_form_id = 'NewsletterPopupForm-' | append: section.id -%}
          {%- form 'customer', id: newsletter_popup_form_id, class: 'newsletter-popup__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,newsletter-popup">

            {%- if form.errors -%}
              <div class="newsletter-popup__message newsletter-popup__message--error form__message" role="alert" tabindex="-1">
                {%- render 'icon-error' -%}
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </div>
            {%- endif -%}

            {%- if form.posted_successfully? -%}
              <div class="newsletter-popup__message newsletter-popup__message--success form__message" tabindex="-1" autofocus>
                {% render 'icon-success' %}
                {{ 'newsletter.success' | t }}
              </div>
            {%- else -%}
              <div class="field">
                <input
                  id="NewsletterPopup-Name-{{ section.id }}"
                  class="field__input"
                  type="text"
                  name="contact[first_name]"
                  autocomplete="name"
                  required
                  value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
                  placeholder="{{ 'newsletter.name' | t }}"
                >
                <label class="field__label" for="NewsletterPopup-Name-{{ section.id }}">
                  {{ 'newsletter.name' | t }}
                </label>
              </div>

              <div class="field">
                <input
                  id="NewsletterPopup-Email-{{ section.id }}"
                  class="field__input"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ 'newsletter.label' | t }}"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="NewsletterPopup-Error-{{ section.id }}"
                  {% endif %}
                >
                <label class="field__label" for="NewsletterPopup-Email-{{ section.id }}">
                  {{ 'newsletter.label' | t }}
                </label>
              </div>

              <div class="field">
                <input
                  id="NewsletterPopup-Phone-{{ section.id }}"
                  class="field__input"
                  type="tel"
                  name="contact[phone]"
                  autocomplete="tel"
                  required
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ 'newsletter.phone' | t }}"
                >
                <label class="field__label" for="NewsletterPopup-Phone-{{ section.id }}">
                  {{ 'newsletter.phone' | t }}
                </label>
              </div>

              <button type="submit" class="newsletter-popup__submit button button--full-width" name="commit">
                {{ section.settings.button_label }}
              </button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  </dialog>
</newsletter-popup>

{% schema %}
{
  "name": "t:sections.newsletter_popup.name",
  "tag": "section",
  "class": "section-newsletter-popup",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter_popup.settings.heading.label",
      "default": "Join Maison Veil"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter_popup.settings.text.label",
      "default": "<p>Private launches. Exclusive invitations. Early access.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter_popup.settings.button_label.label",
      "default": "Subscribe"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.newsletter_popup.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "t:sections.newsletter_popup.settings.image_layout.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.newsletter_popup.settings.image_layout.options__none.label"
        },
        {
          "value": "background",
          "label": "t:sections.newsletter_popup.settings.image_layout.options__background.label"
        },
        {
          "value": "left",
          "label": "t:sections.newsletter_popup.settings.image_layout.options__left.label"
        },
        {
          "value": "right",
          "label": "t:sections.newsletter_popup.settings.image_layout.options__right.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "t:sections.newsletter_popup.settings.image_overlay_opacity.label",
      "default": 50
    },
    {
      "type": "range",
      "id": "hide_days",
      "min": 1,
      "max": 14,
      "step": 1,
      "unit": "d",
      "label": "t:sections.newsletter_popup.settings.hide_days.label",
      "info": "t:sections.newsletter_popup.settings.hide_days.info",
      "default": 3
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter_popup.name"
    }
  ]
}
{% endschema %}
