{{ 'section-book-consultation.css' | asset_url | stylesheet_tag }}

<section
  id="BookConsultationForm-{{ section.id }}"
  class="maison-book color-{{ section.settings.color_scheme }} isolate gradient"
>
  <div class="maison-book__wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank -%}
      <div class="maison-book__head">
        {%- if section.settings.kicker != blank -%}
          <div class="maison-book__kicker">{{ section.settings.kicker | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="maison-book__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="maison-book__desc">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="maison-book__desc">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="maison-book__panel">
      {% form 'contact', id: 'BookConsultationForm', class: 'maison-book__form' %}
        {%- if form.posted_successfully? -%}
          <div class="maison-book__status" tabindex="-1" autofocus>
            <h3>Your consultation is reserved.</h3>
            <p>We’ve received your perfume-bar request and will reply within 24 hours to confirm date, guest count, and blending details.</p>
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="maison-book__status maison-book__status--error">
            <h3>Please correct the following:</h3>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[subject]" value="Maison Veil Perfume Bar Consultation">

        <div class="maison-book__grid">
          <div class="maison-book__field">
            <div class="field">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="BookConsultationForm-name"
                name="contact[name]"
                required
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Full name"
              >
              <label class="field__label" for="BookConsultationForm-name">
                Full name <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>
          <div class="maison-book__field">
            <div class="field">
              <input
                autocomplete="email"
                type="email"
                id="BookConsultationForm-email"
                class="field__input"
                name="contact[email]"
                required
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                placeholder="Email"
              >
              <label class="field__label" for="BookConsultationForm-email">
                Email <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>
        </div>

        <div class="maison-book__field">
          <div class="field">
            <input
              type="tel"
              id="BookConsultationForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="Phone"
            >
            <label class="field__label" for="BookConsultationForm-phone">Phone</label>
          </div>
        </div>

        <div class="maison-book__grid">
          <div class="maison-book__field">
            <div class="field">
              <input
                type="date"
                id="BookConsultationForm-event-date"
                class="field__input"
                name="contact[event_date]"
                min="{{ 'now' | date: '%Y-%m-%d' }}"
                value="{% if form.event_date %}{{ form.event_date }}{% endif %}"
                required
              >
              <label class="field__label" for="BookConsultationForm-event-date">
                Event date <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>
          <div class="maison-book__field">
            <div class="field">
              <input
                type="number"
                id="BookConsultationForm-guest-count"
                class="field__input"
                name="contact[guest_count]"
                min="1"
                max="1000"
                value="{% if form.guest_count %}{{ form.guest_count }}{% endif %}"
                placeholder="Guest count"
                required
              >
              <label class="field__label" for="BookConsultationForm-guest-count">
                Guest count <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>
        </div>

        <div class="maison-book__grid">
          <div class="maison-book__field">
            <div class="field">
              <input
                type="text"
                id="BookConsultationForm-event-location"
                class="field__input"
                name="contact[event_location]"
                value="{% if form.event_location %}{{ form.event_location }}{% endif %}"
                placeholder="City, venue, or private residence"
                required
              >
              <label class="field__label" for="BookConsultationForm-event-location">
                Location <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>
          <div class="maison-book__field">
            <div class="field">
              <select id="BookConsultationForm-service-type" class="field__input" name="contact[service_type]" required>
                <option value="">Select experience</option>
                <option value="Wedding" {% if form.service_type == 'Wedding' %}selected{% endif %}>Wedding perfume bar</option>
                <option value="Birthday" {% if form.service_type == 'Birthday' %}selected{% endif %}>Birthday or social</option>
                <option value="Social Event" {% if form.service_type == 'Social Event' %}selected{% endif %}>Private celebration</option>
                <option value="Corporate Event" {% if form.service_type == 'Corporate Event' %}selected{% endif %}>Corporate / brand activation</option>
              </select>
              <label class="field__label" for="BookConsultationForm-service-type">
                Experience type <span aria-hidden="true">*</span>
              </label>
            </div>
          </div>
        </div>

        <div class="maison-book__field">
          <div class="field">
            <select id="BookConsultationForm-bottle-size" class="field__input" name="contact[bottle_size]" required>
              <option value="">Select bottle size</option>
              <option value="10 ml" {% if form.bottle_size == '10 ml' %}selected{% endif %}>10 ml — $20</option>
              <option value="30 ml" {% if form.bottle_size == '30 ml' %}selected{% endif %}>30 ml — $35</option>
              <option value="50 ml" {% if form.bottle_size == '50 ml' %}selected{% endif %}>50 ml — $50</option>
              <option value="100 ml" {% if form.bottle_size == '100 ml' %}selected{% endif %}>100 ml — $95</option>
            </select>
            <label class="field__label" for="BookConsultationForm-bottle-size">
              Guest bottle size <span aria-hidden="true">*</span>
            </label>
          </div>
        </div>

        <div class="maison-book__field">
          <div class="field">
            <textarea
              rows="6"
              id="BookConsultationForm-message"
              class="text-area field__input"
              name="contact[body]"
              placeholder="Theme, color story, scent preferences, branding, or timing notes"
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
            <label class="form__label field__label" for="BookConsultationForm-message">Additional notes</label>
          </div>
        </div>

        {%- if section.settings.show_privacy_notice -%}
          <label class="maison-book__privacy">
            <input type="checkbox" required>
            <span>{{ section.settings.privacy_notice_text }}</span>
          </label>
        {%- endif -%}

        <div class="maison-book__submit">
          <button type="submit" class="mv-cta">
            <span>{{ section.settings.button_text | default: 'Request the perfume bar' }}</span>
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Book Consultation Form",
  "tag": "section",
  "class": "section-book-consultation",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Perfume bar · Private booking"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Book a <em>consultation.</em>"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tell us about your wedding, celebration, or brand activation."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We reply within 24 hours with availability, guest-bottle options, and how the live blending bar will feel on the day.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Request the perfume bar"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Privacy"
    },
    {
      "type": "checkbox",
      "id": "show_privacy_notice",
      "label": "Show privacy notice",
      "default": true
    },
    {
      "type": "richtext",
      "id": "privacy_notice_text",
      "label": "Privacy notice",
      "default": "<p>I agree to the <a href=\"/pages/privacy-policy\">Privacy Policy</a> and consent to being contacted about this perfume-bar consultation.</p>"
    }
  ],
  "presets": [
    {
      "name": "Book Consultation Form"
    }
  ]
}
{% endschema %}
