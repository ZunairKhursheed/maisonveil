{{ 'section-maison-experience.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-experience.js' | asset_url }}" defer="defer"></script>

{%- assign card_blocks = section.blocks | where: 'type', 'card' -%}

<maison-experience
  class="maison-experience color-{{ section.settings.color_scheme }} isolate gradient"
  id="experience"
  data-section-id="{{ section.id }}"
>
  <div class="maison-experience__wrap">
    <div class="maison-experience__head mv-reveal">
      {%- if section.settings.kicker != blank -%}
        <div class="maison-experience__kicker">{{ section.settings.kicker | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="maison-experience__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="maison-experience__divider" aria-hidden="true"></div>
      {%- if section.settings.description != blank -%}
        <div class="maison-experience__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if card_blocks.size > 0 -%}
      <div class="maison-experience__grid">
        {%- for block in card_blocks -%}
          <article class="maison-experience__card mv-reveal" {{ block.shopify_attributes }}>
            <div>
              {%- if block.settings.kicker != blank -%}
                <div class="maison-experience__card-kicker">{{ block.settings.kicker | escape }}</div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="maison-experience__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="maison-experience__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.link_label != blank -%}
              <a class="maison-experience__link" href="{{ block.settings.link | default: '#' }}">
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</maison-experience>

{% schema %}
{
  "name": "Maison experience",
  "tag": "section",
  "class": "section-maison-experience",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "06 · Private Commissions"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "More than a <em>Scent.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Beyond our permanent collection, Maison Veil curates unforgettable private olfactory rituals for momentous celebrations and distinguished collectors.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Experience card",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Private Sittings" },
        { "type": "text", "id": "title", "label": "Title", "default": "Bespoke Scent Formulation" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "An intimate two-day private session with our Master Perfumer in our Paris salon." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Reserve Salon Appointment →" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maison experience",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "kicker": "Private Sittings",
            "title": "Bespoke Scent Formulation",
            "text": "An intimate two-day private session with our Master Perfumer in our Paris salon. Formulate a personalized extrait unique to your skin that will never be reproduced.",
            "link_label": "Reserve Salon Appointment →"
          }
        },
        {
          "type": "card",
          "settings": {
            "kicker": "Celebrations",
            "title": "Bridal & Event Scenting",
            "text": "Transform your wedding or gala into an unforgettable olfactory memory. Bespoke spatial diffusion and personalized engraved flacons presented to your guests.",
            "link_label": "Plan Event Experience →"
          }
        },
        {
          "type": "card",
          "settings": {
            "kicker": "Haute Gifting",
            "title": "Executive & VIP Flacons",
            "text": "Custom presentation chests lined in black velvet, sealed with personalized gold wax insignias and individually serialized for distinguished patrons.",
            "link_label": "Explore VIP Gifting →"
          }
        }
      ]
    }
  ]
}
{% endschema %}
