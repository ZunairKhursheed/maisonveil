{{ 'section-maison-experience.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-experience.js' | asset_url }}" defer="defer"></script>

{%- assign card_blocks = section.blocks | where: 'type', 'card' -%}

<maison-experience
  class="maison-experience color-{{ section.settings.color_scheme }} isolate gradient"
  id="experience"
  data-section-id="{{ section.id }}"
>
  <div class="maison-experience__wrap">
    <div class="maison-experience__head mv-reveal">
      {%- if section.settings.kicker != blank -%}
        <div class="maison-experience__kicker">{{ section.settings.kicker | escape }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="maison-experience__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      <div class="maison-experience__divider" aria-hidden="true"></div>
      {%- if section.settings.description != blank -%}
        <div class="maison-experience__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if card_blocks.size > 0 -%}
      <div class="maison-experience__grid">
        {%- for block in card_blocks -%}
          <article class="maison-experience__card mv-reveal" {{ block.shopify_attributes }}>
            <div>
              {%- if block.settings.kicker != blank -%}
                <div class="maison-experience__card-kicker">{{ block.settings.kicker | escape }}</div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="maison-experience__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="maison-experience__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
            {%- liquid
              assign card_href = block.settings.link
              if block.settings.title contains '@'
                assign card_href = 'mailto:' | append: block.settings.title
              endif
            -%}
            {%- if block.settings.link_label != blank -%}
              <a class="maison-experience__link" href="{{ card_href | default: '#' }}">
                {{ block.settings.link_label | escape }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</maison-experience>

{% schema %}
{
  "name": "Maison experience",
  "tag": "section",
  "class": "section-maison-experience",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "06 · Private Commissions"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "More than a <em>Scent.</em>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Beyond the shop, Maison Veil hosts live perfume bars and designs fragrance gifts for celebrations and brands.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Experience card",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Private sittings" },
        { "type": "text", "id": "title", "label": "Title", "default": "Compose your signature" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "A guided blending sitting at the perfume bar—compose a signature from premium oils." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Book a consultation →" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maison experience",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "kicker": "Perfume bar",
            "title": "Compose your signature",
            "text": "A guided blending sitting at the perfume bar—compose a signature from premium oils, tailored to your skin and the moment you want to hold.",
            "link_label": "Book a consultation →"
          }
        },
        {
          "type": "card",
          "settings": {
            "kicker": "Celebrations",
            "title": "Bridal & Event Scenting",
            "text": "Invite the perfume bar to your wedding or gala. Guests blend their own scents and leave with bottles that remember the night.",
            "link_label": "Plan an event →"
          }
        },
        {
          "type": "card",
          "settings": {
            "kicker": "Gifting",
            "title": "Corporate & VIP gifts",
            "text": "Branded bottles, curated boxes, and bulk gifting for clients, teams, and launches—fragrance that outlasts a thank-you note.",
            "link_label": "Explore corporate gifting →"
          }
        }
      ]
    }
  ]
}
{% endschema %}
