{{ 'section-maison-acclaim.css' | asset_url | stylesheet_tag }}
<script src="{{ 'maison-acclaim.js' | asset_url }}" defer="defer"></script>

{%- assign review_blocks = section.blocks | where: 'type', 'review' -%}

<maison-acclaim
  class="maison-acclaim color-{{ section.settings.color_scheme }} isolate gradient"
  data-section-id="{{ section.id }}"
>
  <div class="maison-acclaim__wrap">
    <div class="maison-acclaim__quote-box mv-reveal">
      <div class="maison-acclaim__mark" aria-hidden="true">“</div>
      <p class="maison-acclaim__quote" data-acclaim-quote>
        {%- if review_blocks.size > 0 -%}
          {{ review_blocks.first.settings.quote | escape }}
        {%- endif -%}
      </p>
      <div class="maison-acclaim__author" data-acclaim-author>
        {%- if review_blocks.size > 0 -%}
          {{ review_blocks.first.settings.author | escape }}
        {%- endif -%}
      </div>

      {%- if review_blocks.size > 0 -%}
        <div class="maison-acclaim__logos" role="tablist" aria-label="{{ section.settings.logos_label | default: 'Guest voices' | escape }}">
          {%- for block in review_blocks -%}
            <button
              type="button"
              class="maison-acclaim__logo{% if forloop.first %} is-active{% endif %}"
              data-acclaim-logo
              data-acclaim-index="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.logo_label | default: block.settings.author | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <script type="application/json" data-acclaim-quotes>
        [
          {%- for block in review_blocks -%}
            {
              "quote": {{ block.settings.quote | json }},
              "author": {{ block.settings.author | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    </div>
  </div>
</maison-acclaim>

{% schema %}
{
  "name": "Maison acclaim",
  "tag": "section",
  "class": "section-maison-acclaim",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "logos_label",
      "label": "Logos row label",
      "default": "Guest voices"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "logo_label", "label": "Logo label", "default": "WEDDINGS" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Our wedding guests still talk about blending their own scents. It felt luxurious without being stiff—exactly what we wanted the night to feel like." },
        { "type": "text", "id": "author", "label": "Author", "default": "— Private wedding, perfume bar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Maison acclaim",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "logo_label": "WEDDINGS",
            "quote": "Our wedding guests still talk about blending their own scents. It felt luxurious without being stiff—exactly what we wanted the night to feel like.",
            "author": "— Private wedding, perfume bar"
          }
        },
        {
          "type": "review",
          "settings": {
            "logo_label": "BOUTIQUE",
            "quote": "I came for a dupe energy and left with a signature. The oils are rich, the blending is theater, and I wear it every day.",
            "author": "— Boutique guest"
          }
        },
        {
          "type": "review",
          "settings": {
            "logo_label": "BRANDS",
            "quote": "We used Maison Veil for a client dinner. Branded bottles, easy logistics, and people actually used the gift.",
            "author": "— Brand activation host"
          }
        },
        {
          "type": "review",
          "settings": {
            "logo_label": "SIGNATURE",
            "quote": "Crimson Smoke lasted through a full night out. Dark, cherry, unforgettable. This is my veil.",
            "author": "— Collection client"
          }
        }
      ]
    }
  ]
}
{% endschema %}
