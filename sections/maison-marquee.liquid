{{ 'section-maison-marquee.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div class="maison-marquee color-{{ section.settings.color_scheme }} isolate gradient" {{ section.shopify_attributes }}>
    <div class="maison-marquee__track" aria-hidden="true">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <div class="maison-marquee__item" {{ block.shopify_attributes }}>
            <span class="maison-marquee__star">✦</span>
            <span>{{ block.settings.text | escape }}</span>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <div class="visually-hidden">
      {%- for block in section.blocks -%}
        <span>{{ block.settings.text | escape }}</span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.maison_marquee.name",
  "tag": "section",
  "class": "section-maison-marquee",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.maison_marquee.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.maison_marquee.blocks.item.settings.text.label",
          "default": "Original Signature Compositions"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.maison_marquee.name",
      "blocks": [
        { "type": "item", "settings": { "text": "Original Signature Compositions" } },
        { "type": "item", "settings": { "text": "Premium Fragrance Oils" } },
        { "type": "item", "settings": { "text": "Live Perfume Bar Blending" } },
        { "type": "item", "settings": { "text": "Wedding & Celebration Scenting" } },
        { "type": "item", "settings": { "text": "Body Oils & Shimmer Veils" } },
        { "type": "item", "settings": { "text": "Complimentary Delivery Over $100" } }
      ]
    }
  ]
}
{% endschema %}
